# Copy to .env.local and adjust. .env.local is gitignored; this file is not,
# so never put a real secret in here.

# GraphQL API (backend-tredella). The console cannot sign in without it.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Fallback the Apollo client uses when NEXT_PUBLIC_GRAPHQL_URL is unset. Set
# one or the other, not both.
# NEXT_PUBLIC_BASE_URL=http://localhost:4000/graphql

# Nothing else is needed. The admin session is the backend's own JWT in a
# cookie (tredella_admin_token) — there is no NextAuth secret to set, and the
# cookie name is deliberately different from the seller app's so both
# dashboards can be open in one browser.

# ---- Production (set these in the Vercel project, not here) ----
# NEXT_PUBLIC_GRAPHQL_URL=https://backend-tredella.vercel.app/graphql
